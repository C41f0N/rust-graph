# Old-glibc release build for maximum distro reach.
#
# Base: Ubuntu 20.04 (glibc 2.31) — a binary built here runs on every
# Linux distro released since ~2020 (Fedora 33+, Debian 11+, Arch, ...).
#
# Build (from the repo root):
#   docker build -t rust-graph-release -f packaging/Dockerfile.release .
#   docker run --rm \
#       -v "$PWD:/work" \
#       -v rust-graph-cargo:/usr/local/cargo \
#       rust-graph-release
#
# The first `docker run` populates the cargo cache volume and takes a few
# minutes; afterwards it is incremental. Output:
#   dist/rust-sandbox-linux-x86_64   (strip it before shipping)
#
FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# Native build deps for raylib/GLFW (both X11 and Wayland backends), rfd/gtk3,
# plus cmake + pkg-config which raylib-sys drives.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    pkg-config \
    curl \
    ca-certificates \
    libx11-dev \
    libxrandr-dev \
    libxi-dev \
    libxcursor-dev \
    libxinerama-dev \
    libxkbfile-dev \
    libxkbcommon-dev \
    libxkbcommon-x11-dev \
    libwayland-dev \
    libwayland-bin \
    wayland-protocols \
    libegl1-mesa-dev \
    libgl1-mesa-dev \
    libgtk-3-dev \
    libclang-dev \
    python3-pip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# Ubuntu 20.04's cmake (3.16) is too old for raylib-sys 6 (>= 3.25).
# The PyPI wheel ships a self-contained, glibc-backed cmake that works
# fine on this base without raising the glibc floor.
RUN pip3 install --no-cache-dir 'cmake>=3.25'

# Rust stable (minimum 1.85 for edition 2024), installed into /usr/local so
# the build cache volume can live at a stable path.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:${PATH}"
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal

WORKDIR /work

# Build into a container-local target dir so the host's target/ is untouched.
# Cargo.lock lives in the repo on the host and comes in through the bind
# mount, so a --locked build keeps the container byte-identical to local
# builds.
ENV CARGO_TARGET_DIR=/tmp/rust-target
CMD ["sh", "-c", \
    "cargo build --release --locked && \
     mkdir -p /work/dist && \
     cp /tmp/rust-target/release/rust-sandbox /work/dist/rust-sandbox-linux-x86_64 && \
     echo 'built dist/rust-sandbox-linux-x86_64'"]